{
  "name": "bookyp",
  "version": "0.0.1",
  "author": "GEPROG GmbH",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "14",
    "pnpm": "6"
  },
  "scripts": {
    "start": "dotenv -- pnpm --filter @bookyp/frontend --filter @bookyp/backend start",
    "start:frontend": "dotenv -- pnpm --filter @bookyp/frontend start",
    "start:backend": "dotenv -- pnpm --filter @bookyp/backend start",
    "docker-compose": "docker-compose -f .devcontainer/docker-compose.without-devcontainer.yml -f .devcontainer/docker-compose.database.yml -p bookyp",
    "docker:up": "pnpm --filter . -- docker-compose up -d",
    "build": "pnpm --filter @bookyp/frontend... --filter @bookyp/backend... build",
    "lint": "pnpm --filter . lint:formatting && pnpm --filter ./packages lint",
    "lint:formatting": "prettier -c .",
    "lint:changed": "pnpm lint:formatting && pnpm --filter \"...[master]\" lint",
    "spellcheck": "cspell '{**,.*}/{*,.*}'",
    "test": "pnpm --filter ./packages test",
    "test:changed": "pnpm --filter \"...[master]\" --filter=!./ test",
    "typecheck": "pnpm --filter ./packages typecheck",
    "typecheck:changed": "pnpm --filter \"...[master]\" --filter=!./ typecheck",
    "clean": "pnpm --filter ./packages clean",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "12.1.4",
    "@commitlint/config-conventional": "12.1.4",
    "cspell": "5.6.3",
    "dotenv-cli": "4.0.0",
    "eslint": "7.28.0",
    "husky": "6.0.0",
    "lint-staged": "11.0.0",
    "prettier": "2.3.2",
    "ts-node": "10.0.0",
    "typescript": "4.2.4",
    "typescript-transform-paths": "2.2.4"
  },
  "pnpm": {
    "overrides": {
      "grant": "5.4.12"
    },
    "neverBuiltDependencies": [
      "fsevents"
    ]
  }
}
