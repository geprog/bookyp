{
  "name": "bookyp",
  "version": "0.0.1",
  "author": "GEPROG GmbH",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "dotenv -- lerna run --include-dependencies --scope @bookyp/frontend --scope @bookyp/backend --parallel start",
    "docker-compose": "docker-compose -f .devcontainer/docker-compose.without-devcontainer.yml -f .devcontainer/docker-compose.database.yml -p bookyp",
    "docker:up": "yarn docker-compose up -d",
    "build": "lerna run build",
    "lint": "yarn lint:formatting && lerna run lint",
    "lint:formatting": "prettier -c .",
    "lint:changed": "yarn lint:formatting && lerna run --since origin/master --include-dependents lint",
    "test": "lerna run test",
    "test:changed": "lerna run --since origin/master --include-dependents test",
    "typecheck": "lerna run typecheck",
    "typecheck:changed": "lerna run --since origin/master --include-dependents typecheck",
    "clean": "lerna run clean"
  },
  "devDependencies": {
    "@commitlint/cli": "12.0.1",
    "@commitlint/config-conventional": "12.0.1",
    "@yarnpkg/pnpify": "2.4.0",
    "cspell": "5.3.7",
    "dotenv-cli": "4.0.0",
    "eslint": "7.21.0",
    "husky": "4.3.8",
    "lerna": "4.0.0",
    "lint-staged": "10.5.4",
    "prettier": "2.2.1",
    "ts-node": "9.1.1",
    "typescript": "4.2.3",
    "typescript-transform-paths": "2.2.3"
  },
  "resolutions": {
    "postcss": "8.2.7",
    "@vue/compiler-core": "3.0.5"
  }
}
