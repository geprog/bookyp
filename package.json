{
  "name": "bookyp",
  "version": "0.0.1",
  "author": "GEPROG GmbH",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "start": "dotenv -- lerna run --include-dependencies --scope @bookyp/frontend --scope @bookyp/backend --parallel start",
    "build": "lerna run build",
    "lint": "yarn lint:globals && lerna run lint",
    "lint:globals": "eslint --report-unused-disable-directives --cache .",
    "lint:changed": "lerna run --since origin/master --include-dependents lint",
    "test": "lerna run test",
    "test:changed": "lerna run --since origin/master --include-dependents test",
    "typecheck": "lerna run typecheck",
    "clean": "lerna run clean"
  },
  "devDependencies": {
    "@commitlint/cli": "11.0.0",
    "@commitlint/config-conventional": "11.0.0",
    "@types/node": "14.14.22",
    "@typescript-eslint/eslint-plugin": "4.14.0",
    "@typescript-eslint/parser": "4.14.0",
    "@yarnpkg/pnpify": "2.4.0",
    "dotenv-cli": "4.0.0",
    "eslint": "7.18.0",
    "eslint-config-prettier": "7.2.0",
    "eslint-plugin-jest": "24.1.3",
    "eslint-plugin-prettier": "3.3.1",
    "husky": "4.3.8",
    "lerna": "3.22.1",
    "lint-staged": "10.5.3",
    "prettier": "2.2.1",
    "ts-node": "9.1.1",
    "typescript": "4.1.3",
    "typescript-transform-paths": "2.2.2"
  },
  "resolutions": {
    "@types/node": "14.14.22",
    "@types/uuid": "7.0.3",
    "@typescript-eslint/eslint-plugin": "4.14.0",
    "@typescript-eslint/parser": "4.14.0",
    "eslint": "7.18.0",
    "eslint-config-prettier": "7.2.0",
    "eslint-plugin-jest": "24.1.3",
    "eslint-plugin-prettier": "3.3.1",
    "prettier": "2.2.1",
    "ts-node": "9.1.1",
    "ttypescript": "1.5.12",
    "typescript": "4.1.3",
    "typescript-transform-paths": "2.2.2",
    "uuid": "7.0.3"
  },
  "husky": {
    "hooks": {
      "commit-msg": "echo HUSKY_GIT_PARAMS && commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged",
      "pre-push": "yarn test:changed"
    }
  },
  "lint-staged": {
    "*": [
      "prettier",
      "eslint"
    ]
  }
}
