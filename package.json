{
  "name": "bookyp",
  "version": "0.0.1",
  "author": "GEPROG GmbH",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.17.1",
    "pnpm": "11"
  },
  "scripts": {
    "start": "dotenv -- pnpm --filter @bookyp/frontend --filter @bookyp/backend... --filter @bookyp/oauth-mock-server --parallel start",
    "start:frontend": "dotenv -- pnpm --filter @bookyp/frontend start",
    "start:backend": "dotenv -- pnpm --filter @bookyp/backend start",
    "start:core": "dotenv -- pnpm --filter @bookyp/core start",
    "start:oauth-mock-server": "dotenv -- pnpm --filter @bookyp/oauth-mock-server start",
    "docker-compose": "docker-compose -f .devcontainer/docker-compose.services.yml -p bookyp",
    "dc": "pnpm docker-compose",
    "docker:up": "pnpm docker-compose up -d",
    "docker:remove-volumes": "pnpm docker-compose down --volumes --remove-orphans",
    "build": "pnpm --filter @bookyp/frontend... --filter @bookyp/backend... build",
    "build:libs": "pnpm --filter @bookyp/core build",
    "lint": "pnpm lint:formatting && pnpm -r lint",
    "lint:formatting": "prettier -c .",
    "spellcheck": "cspell lint --no-progress --gitignore '{**,.*}/{*,.*}'",
    "test": "pnpm -r test",
    "e2e": "cd packages/e2e && pnpm test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "postinstall": "rm -rf ./node_modules/.pnpm/@fullcalendar+core@5.11.0/node_modules/preact/src/jsx.d.ts"
  },
  "devDependencies": {
    "cspell": "8.0.0",
    "dotenv-cli": "4.0.0",
    "eslint": "8.27.0",
    "prettier": "2.4.1",
    "ts-node": "10.0.0",
    "typescript": "5.1.6",
    "@cspell/dict-de-de": "3.2.0"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
