    "docker:remove-volumes": "pnpm docker:down --volumes --remove-orphans",
    "seed": "tsx scripts/seed.ts",
    "tunnel": "tsx scripts/tunnel.ts",
    "gringotts:export": "tsx scripts/gringotts/export.ts",
    "gringotts:import": "tsx scripts/gringotts/import.ts",
    "e2e:server": "nuxt build && node --env-file-if-exists=.env .output/server/index.mjs"
  },
