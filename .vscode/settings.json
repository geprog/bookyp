{
  "eslint.workingDirectories": ["./packages/*/"],
  "javascript.updateImportsOnFileMove.enabled": "never",
  "typescript.updateImportsOnFileMove.enabled": "never",
  "liveshare.populateGitCoAuthors": "never",
  "gitlab.instanceUrl": "https://git.geprog.com",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "conventionalCommits.scopes": ["frontend", "backend", "core"],
  "i18n-ally.keystyle": "nested",
  "i18n-ally.localesPaths": "packages/frontend/src/locales",
  "i18n-ally.sortKeys": true,
  "i18n-ally.enabledFrameworks": ["vue"],
  "volar.tsPlugin": true,
  "volar.codeLens.pugTools": false,
  "volar.codeLens.references": false,
  "editor.formatOnSave": true
}
