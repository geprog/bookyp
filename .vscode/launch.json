{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug - Backend - Jest",
      "skipFiles": ["<node_internals>/**"],
      "cwd": "${workspaceFolder}/packages/backend",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["run", "--inspect-brk", "jest", "--forceExit", "--detectOpenHandles", "--runInBand"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "port": 9229,
      "env": {
        "NODE_OPTIONS": "--experimental-vm-modules"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug - Core - Jest",
      "skipFiles": ["<node_internals>/**"],
      "cwd": "${workspaceFolder}/packages/core",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["run", "--inspect-brk", "jest", "--forceExit", "--detectOpenHandles"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "port": 9229,
      "env": {
        "NODE_OPTIONS": "--experimental-vm-modules"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug - Frontend - Jest",
      "skipFiles": ["<node_internals>/**"],
      "cwd": "${workspaceFolder}/packages/frontend",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["run", "--inspect-brk", "jest", "--forceExit", "--detectOpenHandles", "--runInBand"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "port": 9229,
      "env": {
        "NODE_OPTIONS": "--experimental-vm-modules"
      }
    }
  ]
}
