{
  "packages": [
    "apps/*",
    "libs/*"
  ],
  "npmClient": "yarn",
  "useWorkspaces": true,
  "version": "independent",
  "command": {
    "version": {
      "allowBranch": "master",
      "conventionalCommits": true,
      "amend": true
    }
  },
  "ignoreChanges": ["**/*.test.(t|j)s", "**/*.spec.(t|j)s", "**/*.md"]
}
