{
  "name": "bookyp",
  "dockerComposeFile": ["docker-compose.devcontainer.yml", "docker-compose.services.yml"],
  "service": "app",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "forwardPorts": [3000, 8025, 8081, 9001],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "Vue.volar",
        "bradlc.vscode-tailwindcss",
        "lokalise.i18n-ally",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-german",
        "ms-playwright.playwright"
      ]
    }
  }
}
