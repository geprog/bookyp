{
  "extends": "../../tsconfig.json",

  "compilerOptions": {
    "lib": ["esnext", "dom"],
    "types": ["vite/client"],
    "plugins": [{ "name": "@vuedx/typescript-plugin-vue" }],
    "outDir": "dist",
