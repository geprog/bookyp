# Example env file for running locally

NODE_ENV=development

APP_PORT=4000
APP_HOST=localhost
APP_SECRET=supersecret

# Database configuration
DB_HOST=localhost
DB_PORT=27017
DB_USERNAME=root
DB_PASSWORD=secretPassword

# OAuth configuration
OAUTH_REDIRECT_URL=http://localhost:3000/

# KEYCLOAK configuration
KEYCLOAK_SUBDOMAIN=auth.geprog.com/auth/realms/bookyp
KEYCLOAK_CLIENT=bookyp
KEYCLOAK_SECRET=

# App settings
VITE_BACKEND_URL=http://localhost:4000
