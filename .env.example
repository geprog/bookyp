# Example env file for running locally. Copy it to `.env` and adjust the values.
# Every value maps to a key of `runtimeConfig` in nuxt.config.ts.

NODE_ENV=development

##########################################################################
# Public url of the app (used for links in mails and payment webhooks), leave empty locally to use the url the app is opened at
NUXT_PUBLIC_APP_URL=
NUXT_PUBLIC_ENVIRONMENT_TYPE=development

##########################################################################
# Session (random string with at least 32 characters)
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-with-32-chars

##########################################################################
# Login: `dummy` (default in development, a page that logs in test users without Keycloak) or `keycloak` (default in production)
#NUXT_AUTH_HANDLER=dummy
# Keycloak, only used with the keycloak login
NUXT_OAUTH_KEYCLOAK_SERVER_URL=
NUXT_OAUTH_KEYCLOAK_REALM=bookyp
NUXT_OAUTH_KEYCLOAK_CLIENT_ID=bookyp
NUXT_OAUTH_KEYCLOAK_CLIENT_SECRET=
NUXT_PUBLIC_KEYCLOAK_ACCOUNT_URL=https://auth.geprog.com/auth/realms/bookyp/account

##########################################################################
# Database (docker services started with `pnpm docker:up`)
DB_PORT=27017
DB_USERNAME=root
DB_PASSWORD=supersecret
NUXT_MONGODB_URI=mongodb://root:supersecret@localhost:27017/bookyp?authSource=admin

# comma separated list of e-mail addresses with super admin rights
NUXT_SUPER_ADMIN_EMAILS=hello@bookyp.de,a.bracke@geprog.com,her@bert.de

##########################################################################
# Mail (mailhog from the docker services, web ui at http://localhost:8025)
NUXT_MAIL_HOST=localhost
NUXT_MAIL_PORT=1025
NUXT_MAIL_USERNAME=thisIsNotUsed
NUXT_MAIL_PASSWORD=thisIsNotUsed
NUXT_MAIL_FROM="Bookyp <bookyp@example.com>"
NUXT_MAIL_SECURE=false
NUXT_MAIL_REQUIRE_TLS=false

##########################################################################
# S3 storage for space images (minio from the docker services, console at http://localhost:9001)
S3_ACCESS_KEY=root
S3_SECRET_KEY=supersecret
NUXT_S3_ENDPOINT=localhost
NUXT_S3_PORT=9000
NUXT_S3_USE_SSL=false
NUXT_S3_ACCESS_KEY=root
NUXT_S3_SECRET_KEY=supersecret
NUXT_S3_BUCKET=bookyp-files

##########################################################################
# Payment: `mock` for local development, `mollie` for real payments
NUXT_PAYMENT_PROVIDER=mock
NUXT_PAYMENT_MOLLIE_API_KEY=
NUXT_PAYMENT_VAT_RATE=19

##########################################################################
# E2E Testing configuration (defaults to alice@wonderland.org of the dummy login)
E2E_AUTH_USERNAME=
