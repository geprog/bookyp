{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "packageRules": [
    {
      "matchPackageNames": ["renovate/renovate"],
      "dependencyDashboardApproval": true
    }
  ],
  "regexManagers": [
    {
      "fileMatch": [".yml$", ".yaml$"],
      "matchStrings": ["image: registry\\.geprog\\.com/docker\\.io/(library/)?(?<depName>.*?):(?<currentValue>.*?)\n"],
      "datasourceTemplate": "docker"
    },
    {
      "fileMatch": ["Dockerfile$"],
      "matchStrings": ["FROM registry\\.geprog\\.com/docker\\.io/(library/)?(?<depName>.*?):(?<currentValue>.*?)\n"],
      "datasourceTemplate": "docker"
    }
  ],
  "gitLabAutomerge": true,
  "dependencyDashboard": true,
  "dependencyDashboardApproval": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "stabilityDays": 3,
  "prCreation": "not-pending",
  "labels": ["renovate", "👀 Ready for Review"],
  "constraints": {
    "pnpm": "6"
  }
}
