{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "packageRules": [
    {
      "packageNames": ["renovate/renovate"],
      "dependencyDashboardApproval": true
    }
  ],
  "gitLabAutomerge": true,
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "stabilityDays": 3,
  "prCreation": "not-pending",
  "labels": ["renovate"]
}
