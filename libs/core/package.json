{
  "name": "@bookyp/core",
  "version": "0.0.1",
  "private": true,
  "main": "dist/",
  "types": "dist/",
  "scripts": {
    "start": "ttsc -p tsconfig.build.json --watch",
    "build": "ttsc -p tsconfig.build.json",
    "test": "jest --forceExit --detectOpenHandles",
    "lint": "eslint --report-unused-disable-directives --cache .",
    "typecheck": "ttsc --noEmit",
    "clean": "shx rm -rf dist/ *.tsbuildinfo || true"
  },
  "dependencies": {
    "@feathersjs/authentication": "5.0.0-pre.1",
    "@feathersjs/feathers": "5.0.0-pre.1",
    "uuid": "7.0.3"
  },
  "devDependencies": {
    "@jest/types": "26.6.2",
    "@types/jest": "26.0.20",
    "@types/node": "14.14.22",
    "@types/uuid": "7.0.3",
    "@types/uuid-validate": "0.0.1",
    "@typescript-eslint/eslint-plugin": "4.14.0",
    "@typescript-eslint/parser": "4.14.0",
    "eslint": "7.18.0",
    "eslint-config-prettier": "7.2.0",
    "eslint-plugin-jest": "24.1.3",
    "eslint-plugin-prettier": "3.3.1",
    "jest": "26.6.3",
    "prettier": "2.2.1",
    "shx": "0.3.3",
    "ts-jest": "26.4.4",
    "ts-node": "9.1.1",
    "ttypescript": "1.5.12",
    "typescript": "4.1.3",
    "typescript-transform-paths": "2.2.2",
    "uuid-validate": "0.0.3"
  }
}
