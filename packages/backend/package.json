{
  "name": "@bookyp/backend",
  "version": "0.0.1",
  "private": true,
  "main": "dist/",
  "types": "dist/",
  "scripts": {
    "start": "nodemon",
    "build": "node buildscript.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --forceExit --detectOpenHandles",
    "test:watch": "pnpm test -- --watchAll",
    "lint": "eslint --max-warnings 0 .",
    "lint-fix": "pnpm lint -- --fix",
    "typecheck": "ttsc --noEmit",
    "clean": "rm -rf dist/ node_modules/ .eslintcache"
  },
  "dependencies": {
    "@bookyp/core": "workspace:*",
    "@feathersjs/authentication": "5.0.0-pre.3",
    "@feathersjs/authentication-oauth": "5.0.0-pre.3",
    "@feathersjs/express": "5.0.0-pre.3",
    "@feathersjs/feathers": "5.0.0-pre.3",
    "@feathersjs/socketio": "5.0.0-pre.3",
    "feathers-mongoose": "github:GEPROG/feathers-mongoose#upgrade-feathers",
    "lightship": "6.7.2",
    "mongoose": "github:raphaelschwinger/mongoose#fix-import"
  },
  "devDependencies": {
    "@babel/core": "7.13.10",
    "@babel/plugin-transform-modules-commonjs": "7.13.8",
    "@babel/preset-typescript": "7.13.0",
    "@geprog/eslint-config": "0.0.3",
    "@jest/globals": "27.0.3",
    "@jest/types": "27.0.2",
    "@types/jest": "26.0.21",
    "esbuild": "0.9.6",
    "esbuild-jest": "0.5.0",
    "eslint": "7.28.0",
    "jest": "27.0.4",
    "jest-junit": "12.2.0",
    "nodemon": "2.0.7",
    "tsconfig-paths": "3.9.0",
    "ttypescript": "1.5.12",
    "typescript": "4.2.4",
    "typescript-transform-paths": "2.2.4"
  }
}
