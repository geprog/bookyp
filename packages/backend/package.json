{
  "name": "@bookyp/backend",
  "version": "0.0.1",
  "private": true,
  "main": "dist/",
  "types": "dist/",
  "scripts": {
    "start": "nodemon",
    "build": "node buildscript.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules yarn jest --forceExit --detectOpenHandles",
    "lint": "eslint --report-unused-disable-directives --cache .",
    "typecheck": "ttsc --noEmit",
    "clean": "shx rm -rf dist/"
  },
  "dependencies": {
    "@bookyp/core": "0.0.1",
    "@feathersjs/authentication": "5.0.0-pre.1",
    "@feathersjs/express": "5.0.0-pre.1",
    "@feathersjs/feathers": "5.0.0-pre.1",
    "@feathersjs/socketio": "5.0.0-pre.1",
    "feathers-mongoose": "8.3.1",
    "mongoose": "raphaelschwinger/mongoose#fix-import"
  },
  "devDependencies": {
    "@jest/globals": "27.0.0-next.1",
    "@jest/types": "27.0.0-next.1",
    "@types/jest": "26.0.20",
    "@types/mongoose": "5.10.3",
    "@types/node": "14.14.31",
    "@types/uuid-validate": "0.0.1",
    "@typescript-eslint/eslint-plugin": "4.16.1",
    "@typescript-eslint/parser": "4.16.1",
    "esbuild": "0.8.54",
    "esbuild-jest": "0.4.0",
    "esbuild-plugin-pnp": "0.3.0",
    "eslint": "7.21.0",
    "eslint-config-prettier": "8.1.0",
    "eslint-plugin-jest": "24.1.5",
    "eslint-plugin-prettier": "3.3.1",
    "eslint-plugin-simple-import-sort": "7.0.0",
    "jest": "27.0.0-next.2",
    "nodemon": "2.0.7",
    "pkg-dir": "5.0.0",
    "prettier": "2.2.1",
    "shx": "0.3.3",
    "ts-jest": "27.0.0-next.8",
    "ts-node": "9.1.1",
    "tsconfig-paths": "3.9.0",
    "ttypescript": "1.5.12",
    "typescript": "4.2.3",
    "typescript-transform-paths": "2.2.3"
  }
