    "@types/jest": "26.0.21",
    "@types/nodemailer": "^6.4.4",
    "@types/supertest": "2.0.11",
    "esbuild": "0.9.6",
    "esbuild-jest": "0.5.0",
    "eslint": "8.10.0",
    "feathers-memory": "4.1.0",
    "jest": "27.0.4",
    "jest-junit": "12.2.0",
    "nodemon": "2.0.15",
