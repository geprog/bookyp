{
  "name": "@bookyp/backend",
  "version": "0.0.1",
  "private": true,
  "main": "dist/",
  "types": "dist/",
  "scripts": {
    "start": "nodemon",
    "build": "node buildscript.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules yarn jest --forceExit --detectOpenHandles",
    "lint": "eslint --cache .",
    "typecheck": "ttsc --noEmit",
    "clean": "shx rm -rf dist/"
  },
  "dependencies": {
    "@bookyp/core": "0.0.1",
    "@feathersjs/authentication": "5.0.0-pre.1",
    "@feathersjs/express": "5.0.0-pre.1",
    "@feathersjs/feathers": "5.0.0-pre.1",
    "@feathersjs/socketio": "5.0.0-pre.1",
    "feathers-mongoose": "8.3.1",
    "mongoose": "raphaelschwinger/mongoose#fix-import"
  },
  "devDependencies": {
    "@bookyp/eslint-config": "*",
    "@jest/globals": "27.0.0-next.1",
    "@jest/types": "27.0.0-next.1",
    "@rushstack/eslint-patch": "1.0.6",
    "@types/jest": "26.0.20",
    "@types/mongoose": "5.10.3",
    "esbuild": "0.9.2",
    "esbuild-jest": "0.4.0",
    "esbuild-plugin-pnp": "0.3.0",
    "eslint": "7.22.0",
    "jest": "27.0.0-next.2",
    "nodemon": "2.0.7",
    "pkg-dir": "5.0.0",
    "shx": "0.3.3",
    "ts-jest": "27.0.0-next.6",
    "ts-node": "9.1.1",
    "tsconfig-paths": "3.9.0",
    "ttypescript": "1.5.12",
    "typescript": "4.2.3",
    "typescript-transform-paths": "2.2.3"
  }
}
