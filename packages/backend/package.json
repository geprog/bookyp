    "@feathersjs/express": "5.0.0-pre.17",
    "@feathersjs/feathers": "5.0.0-pre.17",
    "@feathersjs/socketio": "5.0.0-pre.17",
    "@geprog/node-migrate-ts": "3.1.12",
    "express": "4.17.1",
    "feathers-casl": "github:geprog/feathers-casl#4253644043fb8d4408c386f675a190d4451a29e7",
