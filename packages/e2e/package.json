{
  "name": "@bookyp/e2e",
  "version": "0.0.1",
  "scripts": {
    "clean": "rm -rf node_modules/ test-results/ storageState.json",
    "codegen": "playwright codegen --load-storage=storageState.json localhost:3000",
    "lint": "eslint --max-warnings 0 .",
    "playwright:install": "playwright install && playwright install-deps",
    "start:e2e": "BACKEND_HOST=localhost BACKEND_PORT=4010 FRONTEND_PORT=3010 BACKEND_OAUTH_REDIRECT_URL=http://localhost:3010/ FRONTEND_BACKEND_URL=http://localhost:4010 dotenv -e .env -e ../../.env -- pnpm --filter @bookyp/frontend --filter @bookyp/backend start",
    "seed": "ts-node-transpile-only --skip-project seedCli.ts",
    "test": "FRONTEND_PORT=3010 playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@bookyp/core": "workspace:*",
    "@geprog/eslint-config": "1.1.1",
    "@playwright/test": "1.23.0",
    "dotenv": "16.0.1",
    "eslint": "8.10.0",
    "mongodb": "4.1.4",
    "typescript": "4.6.2"
  },
  "dependencies": {
    "dayjs": "1.10.5"
  }
}
