{
  "name": "@bookyp/core",
  "version": "0.0.1",
  "private": true,
  "main": "dist/",
  "types": "dist/",
  "scripts": {
    "start": "pnpm build -- --watch src/",
    "build": "tsup src/index.ts --dts --format cjs,esm",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --forceExit --detectOpenHandles",
    "test:watch": "pnpm test -- --watchAll",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "ttsc --noEmit",
    "clean": "rm -rf dist/ node_modules/ *.tsbuildinfo .eslintcache"
  },
  "dependencies": {
    "@casl/ability": "5.4.3",
    "@feathersjs/adapter-commons": "5.0.0-pre.17",
    "@feathersjs/authentication": "5.0.0-pre.17",
    "@feathersjs/feathers": "5.0.0-pre.17",
    "bson-objectid": "2.0.3"
  },
  "devDependencies": {
    "@babel/core": "7.13.10",
    "@babel/plugin-transform-modules-commonjs": "7.13.8",
    "@babel/preset-typescript": "7.13.0",
    "@geprog/eslint-config": "1.1.1",
    "@jest/globals": "27.0.3",
    "@jest/types": "27.0.2",
    "@types/jest": "26.0.21",
    "esbuild": "0.9.6",
    "esbuild-jest": "0.5.0",
    "eslint": "8.10.0",
    "jest": "27.0.4",
    "jest-junit": "12.2.0",
    "tsup": "5.12.1",
    "ttypescript": "1.5.12",
    "typescript": "4.6.2",
    "typescript-transform-paths": "2.2.4"
  }
}
