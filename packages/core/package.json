{
  "name": "@bookyp/core",
  "version": "0.0.1",
  "private": true,
  "main": "dist/",
  "types": "dist/",
  "scripts": {
    "start": "pnpm build --watch src/",
    "build": "tsup src/index.ts --dts --format cjs,esm",
    "test": "vitest run --coverage",
    "test:watch": "vitest --ui --open false",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist/ node_modules/ *.tsbuildinfo .eslintcache"
  },
  "dependencies": {
    "@casl/ability": "5.4.3",
    "@feathersjs/adapter-commons": "5.0.0-pre.17",
    "@feathersjs/authentication": "5.0.0-pre.17",
    "@feathersjs/feathers": "5.0.0-pre.17",
    "bson-objectid": "2.0.3"
  },
  "devDependencies": {
    "@geprog/eslint-config": "1.1.2",
    "@vitest/coverage-c8": "0.23.4",
    "@vitest/ui": "0.23.4",
    "eslint": "8.10.0",
    "tsup": "5.12.1",
    "typescript": "4.6.2",
    "vitest": "0.23.4"
  }
}
