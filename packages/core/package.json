{
  "name": "@bookyp/core",
  "version": "0.0.1",
  "private": true,
  "main": "dist/",
  "types": "dist/",
  "scripts": {
    "start": "ttsc -p tsconfig.build.json --watch",
    "build": "ttsc -p tsconfig.build.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules yarn jest --forceExit --detectOpenHandles",
    "lint": "eslint --cache .",
    "typecheck": "ttsc --noEmit",
    "clean": "shx rm -rf dist/ *.tsbuildinfo || true"
  },
  "dependencies": {
    "@feathersjs/authentication": "5.0.0-pre.1",
    "@feathersjs/feathers": "5.0.0-pre.1"
  },
  "devDependencies": {
    "@bookyp/eslint-config": "*",
    "@jest/globals": "27.0.0-next.1",
    "@jest/types": "27.0.0-next.1",
    "@rushstack/eslint-patch": "1.0.6",
    "@types/jest": "26.0.20",
    "esbuild": "0.8.54",
    "esbuild-jest": "0.4.0",
    "eslint": "7.22.0",
    "jest": "27.0.0-next.2",
    "shx": "0.3.3",
    "ts-jest": "27.0.0-next.6",
    "ts-node": "9.1.1",
    "ttypescript": "1.5.12",
    "typescript": "4.2.3",
    "typescript-transform-paths": "2.2.3"
  }
}
